{
	"hooks": {
		"SessionStart": [
			{
				"hooks": [{ "type": "command", "command": "node /path/to/jev-sentinel/dist/hook.js --host codex" }]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [{ "type": "command", "command": "node /path/to/jev-sentinel/dist/hook.js --host codex" }]
			}
		],
		"PreToolUse": [
			{
				"matcher": ".*",
				"hooks": [
					{
						"type": "command",
						"command": "node /path/to/jev-sentinel/dist/hook.js --host codex",
						"statusMessage": "Jev is checking this action",
						"timeout": 60
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "shell|apply_patch|read_file|mcp__.*",
				"hooks": [
					{ "type": "command", "command": "node /path/to/jev-sentinel/dist/hook.js --host codex", "timeout": 60 }
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{ "type": "command", "command": "node /path/to/jev-sentinel/dist/hook.js --host codex", "timeout": 60 }
				]
			}
		]
	}
}
